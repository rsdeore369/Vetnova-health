# Vision (medicine labels, skin photos) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Text chat assistant (floating 💬). Prefer a separate key from vision for quota isolation.
GEMINI_CHAT_API_KEY=

# Optional models
# GEMINI_VISION_MODEL=gemini-2.0-flash
# GEMINI_CHAT_MODEL=gemini-2.0-flash

PORT=3000

# false = built-in chat (always works). true = try Gemini for chat (needs quota).
USE_GEMINI_CHAT=false
